<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Matches the Aurora app theme backgrounds so the pre-Compose window
         doesn't flash a mismatched white/black. -->
    <color name="window_background_light">#FFF2FAFA</color>
    <color name="window_background_dark">#FF0C1B1C</color>

    <!-- Accent tint for status-bar notification icons (Kodex teal). -->
    <color name="notif_accent">#FF26A69A</color>

    <!-- Tint for failure notifications (build failed, AI could not finish). -->
    <color name="notif_error">#FFE53935</color>
</resources>
